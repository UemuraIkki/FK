# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Explicit binary files
*.bin binary
*.png binary
*.gif binary
*.mp4 binary
*.npz binary
*.tar.gz binary
*.zip binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
